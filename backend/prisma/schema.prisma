// Prisma schema file for Usafi Backend Foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// System infrastructure model to initialize Prisma client & migrations foundation
model InfrastructureHealth {
  id        String   @id @default(uuid())
  status    String   @default("healthy")
  createdAt DateTime @default(now())
}
